# Скопируйте этот файл в .ftp-credentials и заполните своими данными
# из панели https://cp.beget.com/ftp
# .ftp-credentials никогда не попадёт в git (см. .gitignore)

FTP_HOST="ftp.umniy-site.ru"
FTP_PORT="21"
FTP_USER="your_login"
FTP_PASS="your_password"
# Папка на сервере, в которую публикуется сайт
FTP_REMOTE_DIR="/public_html"
